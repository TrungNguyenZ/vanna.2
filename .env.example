# ===========================================
# AI MODEL CONFIGURATION
# ===========================================
# Supported: anthropic, openai, gemini
AI_PROVIDER=anthropic

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI Configuration  
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Supported: sqlite, postgresql, mysql, mssql
DB_TYPE=sqlite

# SQLite Configuration
SQLITE_DATABASE_PATH=./data/database.db

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=your_database
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_SCHEMA=public

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password

# Microsoft SQL Server Configuration
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=your_database
MSSQL_USER=your_username
MSSQL_PASSWORD=your_password
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ===========================================
# SERVER CONFIGURATION
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# ===========================================
# AGENT MEMORY CONFIGURATION (Optional)
# ===========================================
# Vector store for agent memory (chromadb, pinecone, etc.)
MEMORY_TYPE=chromadb
CHROMA_PERSIST_DIRECTORY=./chroma_memory
